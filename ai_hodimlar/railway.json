{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "ai_hodimlar/Dockerfile",
    "watchPatterns": ["ai_hodimlar/**"]
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/salomatlik",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE"
  }
}
